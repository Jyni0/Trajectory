{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trajectory",
  "version": "2.7.3",
  "identifier": "dev.trajectory.mail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trajectory",
        "width": 1440,
        "height": 700,
        "minWidth": 980,
        "minHeight": 600,
        "backgroundColor": "#101010",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; frame-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
